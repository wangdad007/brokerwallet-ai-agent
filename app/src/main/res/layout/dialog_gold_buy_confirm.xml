<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="28dp"
    android:background="@drawable/bg_gold_market_panel">

    <TextView
        android:id="@+id/tv_buy_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="博弈投资确认"
        android:textColor="#000000"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_buy_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="设置您的下注规模 (BKC)"
        android:textColor="#888888"
        android:textSize="14sp"
        android:gravity="center" />

    <EditText
        android:id="@+id/et_buy_amount"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/custom_edittext_background"
        android:hint="0.00"
        android:inputType="numberDecimal"
        android:padding="16dp"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#000000"
        android:importantForAutofill="no" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="* 您正在通过智能合约 AMM 协议进行去中心化博弈"
        android:textColor="#BBBBBB"
        android:textSize="11sp"
        android:gravity="center" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_buy_confirm"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/custom_button_background"
        android:text="确认投资"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_buy_cancel"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@android:color/transparent"
        android:text="放弃"
        android:textAllCaps="false"
        android:textColor="#888888"
        android:textSize="16sp" />

</LinearLayout>
