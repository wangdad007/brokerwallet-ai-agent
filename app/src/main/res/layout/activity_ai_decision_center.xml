<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#0F172A"
                    android:textSize="34sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="投研中心"
                    android:textColor="#0F172A"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_live_status"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_ai_center_segment_idle"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="更新中"
                    android:textColor="#0F766E"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ai_center_hero"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="黄金策略总览"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_ai_center_hero_status"
                        android:gravity="center"
                        android:paddingHorizontal="11dp"
                        android:text="●  运行中"
                        android:textColor="#5EEAD4"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_hero_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="正在更新市场判断与执行状态…"
                    android:textColor="#B9CFDC"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_stat_managed"
                        style="@style/AiCenterHeroStat"
                        android:text="--\n托管市场" />

                    <TextView
                        android:id="@+id/tv_stat_decisions"
                        style="@style/AiCenterHeroStat"
                        android:layout_marginStart="8dp"
                        android:text="--\n24h 决策" />

                    <TextView
                        android:id="@+id/tv_stat_audits"
                        style="@style/AiCenterHeroStat"
                        android:layout_marginStart="8dp"
                        android:text="--\n开奖审计" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/AiCenterSectionTitle"
                android:layout_marginTop="22dp"
                android:text="近期策略" />

            <TextView
                style="@style/AiCenterSectionSubtitle"
                android:text="按博弈池聚合，仅显示最新判断" />

            <LinearLayout
                android:id="@+id/managed_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                style="@style/AiCenterSectionTitle"
                android:layout_marginTop="22dp"
                android:text="结算复核" />

            <TextView
                style="@style/AiCenterSectionSubtitle"
                android:text="到期市场的证据与最终结果" />

            <LinearLayout
                android:id="@+id/settlement_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/AiCenterSectionTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="市场机会" />

                <TextView
                    android:id="@+id/tab_yes"
                    android:layout_width="62dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_ai_center_segment_active"
                    android:gravity="center"
                    android:text="YES"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tab_no"
                    android:layout_width="62dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_ai_center_segment_idle"
                    android:gravity="center"
                    android:text="NO"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                style="@style/AiCenterSectionSubtitle"
                android:text="只展示达到策略门槛的方向" />

            <LinearLayout
                android:id="@+id/opportunity_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
