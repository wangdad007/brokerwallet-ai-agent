<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_gold_market_panel">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="博弈池创建确认单"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="#DDDDDD" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="8dp">
        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="博弈编号"
            android:textColor="#888888"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tv_summary_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirmed"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="8dp">
        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="博弈逻辑"
            android:textColor="#888888"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tv_summary_logic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logic description here"
            android:textColor="#000000"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="8dp">
        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="博弈周期"
            android:textColor="#888888"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tv_summary_period"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start - End Date"
            android:textColor="#000000"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="8dp">
        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="创建者"
            android:textColor="#888888"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tv_summary_creator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0x..."
            android:textColor="#000000"
            android:textSize="12sp"
            android:ellipsize="middle"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="8dp">
        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="部署时间"
            android:textColor="#888888"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tv_summary_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Now"
            android:textColor="#000000"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_summary_close"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/custom_button_background"
        android:text="已确认并返回市场"
        android:textAllCaps="false"
        android:textColor="#FFFFFF" />

</LinearLayout>
