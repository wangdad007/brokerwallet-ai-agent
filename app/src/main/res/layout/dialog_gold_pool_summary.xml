<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_gold_market_panel">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="博弈池创建摘要"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="#DDDDDD" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="8dp">
        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="博弈池标题"
            android:textColor="#888888"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tv_summary_id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:breakStrategy="simple"
            android:maxLines="3"
            android:text="已确认"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="8dp">
        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="判定规则"
            android:textColor="#888888"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tv_summary_logic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="判定规则将在这里显示"
            android:textColor="#000000"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="8dp">
        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="观察周期"
            android:textColor="#888888"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tv_summary_period"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="开始与截止日期"
            android:textColor="#000000"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="8dp">
        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="创建者"
            android:textColor="#888888"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tv_summary_creator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0x..."
            android:textColor="#000000"
            android:textSize="12sp"
            android:ellipsize="middle"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="8dp">
        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="创建时间"
            android:textColor="#888888"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tv_summary_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="刚刚"
            android:textColor="#000000"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_summary_close"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/custom_button_background"
        android:text="完成 · 返回博弈市场"
        android:textAllCaps="false"
        android:textColor="#FFFFFF" />

</LinearLayout>
