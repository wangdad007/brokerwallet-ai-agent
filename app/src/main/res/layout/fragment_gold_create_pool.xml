<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:animateLayoutChanges="true">

        <!-- Page Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="创建自定义博弈池"
            android:textColor="#1A1A1A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="使用自然语言交给 AI 创建，或手动配置博弈池模板。"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- Mode Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_gold_condition_strip"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tab_ai_create"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="AI 创建"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_manual_create"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="手动创建"
                android:textColor="#475569"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- AI Assistant Section -->
        <LinearLayout
            android:id="@+id/section_ai_create"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/et_ai_input"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:background="@drawable/custom_edittext_background"
                android:gravity="top"
                android:hint="例如：创建一个预测黄金下周一能否达到 2400 美元的博弈池…"
                android:padding="14dp"
                android:textSize="14sp"
                android:textColor="#334155"
                android:inputType="textMultiLine"
                android:importantForAutofill="no" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_ai_analyze"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/custom_button_background_black"
                android:text="生成博弈池配置"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Manual Section -->
        <LinearLayout
            android:id="@+id/section_manual_create"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">


            <GridLayout
                android:id="@+id/template_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gold_template_grid"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                android:clipToOutline="true">
                <!-- Templates added dynamically -->
            </GridLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="40dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
